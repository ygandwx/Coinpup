# Development only. Replace this before starting Compose; never commit .env.
POSTGRES_PASSWORD=replace-with-a-generated-local-password
COINPUP_ENVIRONMENT=development
# For local Python (outside Compose). URL-encode special characters in the password.
COINPUP_DATABASE_URL=postgresql+psycopg://coinpup:replace-with-a-generated-local-password@localhost:5432/coinpup
# Browser origins must exactly match scheme/host/port. Production requires explicit HTTPS origins.
COINPUP_ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000","http://127.0.0.1:5173","http://localhost:5173"]
